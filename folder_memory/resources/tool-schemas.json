    "function": {
      "name": "handy_artifact",
      "description": "Create an offline HTML utility in .handy/artifacts. Select one kind and only its options; omit defaults. timer requires options.seconds. password creates a generator. Report the returned HTML path.",
      "parameters": {
        "type": "object",

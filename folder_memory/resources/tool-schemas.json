  {
    "type": "function",
    "function": {
      "name": "handy_schedule_change",
      "description": "Watch public product price changes with desktop notifications. create needs url, interval_count, interval_unit and direction; omit job_id. Other operations need an ID from handy_schedule_list. No numeric thresholds or signed-in tabs. Every change needs user confirmation; report the actual receipt and worker state.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "create",
              "edit",
              "enable",
              "disable",
              "delete"
            ]
          },
          "url": {
            "type": "string",
            "description": "Public HTTP or HTTPS product page, required for create.",
            "maxLength": 4096
          },
          "interval_count": {
            "type": "integer",
            "description": "Use with interval_unit: minute<=525600, hour<=8760, day<=365, week<=52, month<=120.",
            "minimum": 1,
            "maximum": 525600
          },
          "interval_unit": {
            "type": "string",
            "enum": [
              "minute",
              "hour",
              "day",
              "week",
              "month"
            ],
            "description": "Required with interval_count; months are calendar months."
          },
          "direction": {
            "type": "string",
            "enum": [
              "down",
              "up",
              "any"
            ],
            "description": "Required on create: down, up or any. When editing, omit unchanged settings."
          },
          "title": {
            "type": "string",
            "description": "Short watch name.",
            "maxLength": 120
          },
          "xpath": {
            "type": "string",
            "description": "Optional supported id-anchored XPath to a literal price.",
            "maxLength": 512
          },
          "currency": {
            "type": "string",
            "description": "Optional uppercase currency code, e.g. RUB or USD; omit to detect from the page.",
            "maxLength": 3
          },
          "job_id": {
            "type": "string",
            "description": "ID from handy_schedule_list; required for edit/enable/disable/delete, forbidden for create.",
            "maxLength": 12,
            "pattern": "^[0-9a-f]{12}$",
            "minLength": 12
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "create"
              },
              "url": {
                "type": "string",
                "description": "Public HTTP or HTTPS product page, required for create.",
                "maxLength": 4096
              },

                "maxLength": 160,
                "minLength": 1
              },
              "seconds": {
                "type": "integer",
                "description": "Countdown duration in seconds, required for timer.",
                "minimum": 1,
                "maximum": 86400
              },
              "focus_minutes": {
                "type": "integer",
                "description": "Pomodoro focus, default 25.",
                "minimum": 1,
                "maximum": 120,
                "default": 25
              },
              "short_break_minutes": {
                "type": "integer",
                "description": "Pomodoro short break, default 5.",
                "minimum": 1,
                "maximum": 60,
                "default": 5
              },
              "long_break_minutes": {
                "type": "integer",
                "description": "Pomodoro long break, default 15.",
                "minimum": 1,
                "maximum": 60,
                "default": 15
              },
              "rounds": {
                "type": "integer",
                "description": "Pomodoro rounds, default 4.",
                "minimum": 1,
                "maximum": 12,
                "default": 4
              },
              "time_zone": {
                "type": "string",
                "description": "Clock IANA time zone or city. Omit for local time.",
                "maxLength": 180,
                "minLength": 1
              },
              "count": {
                "type": "integer",
                "description": "Dice count, default 1.",
                "minimum": 1,
                "maximum": 20,
                "default": 1
              },
              "sides": {
                "type": "integer",
                "description": "Dice sides, default 6.",
                "minimum": 2,
                "maximum": 1000,
                "default": 6
              },
              "length": {
                "type": "integer",
                "description": "Password generator length, default 24.",
                "minimum": 4,
                "maximum": 128,

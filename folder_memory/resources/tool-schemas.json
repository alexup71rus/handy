            "pattern": "^[0-9]{1,10}$",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "description": "HTTP/HTTPS URL: existing tab for read, destination for open. Omit for list.",
            "maxLength": 4096
          },
          "query": {
            "type": "string",
            "description": "Read only: optional topic or section to focus on.",
            "maxLength": 300
          },
          "selector": {
            "type": "string",
            "description": "Read only: optional CSS selector or XPath for one region.",
            "maxLength": 512
          },
          "connection_id": {
            "type": "string",

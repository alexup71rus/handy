{
  "schema_version": 1,
  "purpose": "Read-only signals used by reference evidence selection.",
  "signals": {
    "recall": [
      "\\b(?:напомни|вспомни|recall|remind)\\b",
      "\\b(?:номер|телефон|контакт|адрес)\\w*\\b.*\\bты\\s+запомнил[аи]?\\b",
      "\\bсохран[её]нн\\w*\\s+(?:номер\\w*|телефон\\w*|контакт\\w*|адрес\\w*|факт\\w*|значени\\w*)\\b",
      "\\bиз\\s+памяти\\s+(?:номер|телефон|контакт|адрес|факт|значение)\\w*\\b"
    ],
    "system_state": [
      "\\bнагрузк\\w*\\b",
      "\\b(?:свободн\\w*\\s+мест\\w*|оперативн\\w*\\s+памят\\w*|процессор\\w*)\\b",
      "\\b(?:операционн\\w*\\s+систем\\w*|operating\\s+system|объ[её]м\\w*\\s+памят\\w*|memory\\s+size)\\b",
      "\\b(?:состояни\\w*|характеристик\\w*|параметр\\w*)\\s+(?:(?:этого|моего|локальн\\w*)\\s+)?(?:компьютер\\w*|ноутбук\\w*|мака)\\b",
      "\\b(?:сколько|покажи|проверь)\\b.*\\b(?:ram|cpu|диск\\w*)\\b"
    ]
  }
}
